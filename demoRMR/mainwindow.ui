  <property name="styleSheet">
   <string notr="true">
QWidget { font-family: "Segoe UI"; font-size: 14px; color: #14243b; }
QWidget#centralWidget { background-color: #eef1f5; }
QLabel { background-color: transparent; }
QFrame#headerBar, QFrame#bottomBar { background-color: #f8f9fb; border: 1px solid #c9d0da; border-radius: 3px; }
QLabel#titleLabel { font-size: 15px; font-weight: bold; }
QLabel#connectionStatusLabel { color: #596579; }
QLabel#connectionDotLabel { color: #808890; font-size: 20px; }
QGroupBox {
    background-color: #f8f9fb; border: 1px solid #c9d0da;
    border-radius: 3px; margin-top: 10px; padding: 4px; padding-top: 12px; font-weight: bold;
}
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 10px; padding: 0px 4px; color: #152b4b; }
QGroupBox QLabel, QGroupBox QPushButton, QGroupBox QListWidget, QGroupBox QTableWidget, QGroupBox QCheckBox { font-weight: normal; }
QPushButton {
    background-color: #e6eaf0; border: 1px solid #aeb8c6;
    border-radius: 3px; padding: 6px 12px; min-height: 26px;
}
QPushButton:hover { background-color: #dceafa; border-color: #6c9aca; }
QPushButton:pressed, QPushButton:checked { background-color: #2375bd; border-color: #1b5d96; color: white; }
QPushButton:focus { border: 2px solid #2375bd; }
QPushButton:disabled { color: #87909c; background-color: #ebedf0; border-color: #ccd1d8; }
QPushButton#startMissionButton:enabled, QPushButton#resumeMissionButton:enabled, QPushButton#playButton { background-color: #2375bd; border-color: #1b5d96; color: white; font-weight: bold; }
QPushButton#abortMissionButton:enabled, QPushButton#deleteRecordButton:enabled { background-color: white; border-color: #b91c1c; color: #b91c1c; }
QLineEdit, QComboBox {
    background-color: white; border: 1px solid #aeb8c6;
    border-radius: 3px; padding: 5px 8px; min-height: 26px;
}
QLineEdit:focus, QComboBox:focus { border-color: #2375bd; }
QComboBox QAbstractItemView {
    background-color: white; color: #14243b; border: 1px solid #aeb8c6;
    selection-background-color: #2375bd; selection-color: white; outline: 0;
}
QTableWidget QComboBox { padding: 1px 6px; min-height: 0px; border-radius: 0px; }
QMenu { background-color: white; color: #14243b; border: 1px solid #aeb8c6; padding: 4px 0px; }
QMenu::item { padding: 6px 24px 6px 24px; background-color: transparent; }
QMenu::item:selected { background-color: #2375bd; color: white; }
QMenu::item:disabled { color: #596579; font-weight: bold; }
QMenu::separator { height: 1px; background: #c9d0da; margin: 4px 8px; }QLineEdit:read-only { background-color: #e9edf2; color: #647084; }
QListWidget, QTableWidget { background-color: white; border: 1px solid #c9d0da; border-radius: 3px; }
QTableWidget::item:selected, QListWidget::item:selected { background-color: #dceafa; color: #14243b; }
QHeaderView::section { background-color: #e6eaf0; border: none; border-bottom: 1px solid #c9d0da; padding: 4px; font-size: 12px; }
QProgressBar { background-color: #dfe4ea; border: none; border-radius: 5px; max-height: 10px; }
QProgressBar::chunk { background-color: #0f766e; border-radius: 5px; }
QWidget#mapView { background-color: #242d38; border: 1px solid #647184; border-radius: 3px; }
QLabel#cameraLabel { background-color: #2a333e; color: #ccd5df; border-radius: 2px; }
QLabel#pointsHintLabel { color: #596579; font-size: 12px; }
QLabel#legendLabel { color: #3c4a5e; font-size: 13px; }
QLabel#recIndicatorLabel { color: #b91c1c; font-weight: bold; }
QPushButton#safetyStopButton {
    background-color: rgba(115, 28, 35, 238); color: white;
    border: 2px solid #ef9a9a; border-radius: 7px;
    font-size: 15px; font-weight: bold; padding: 6px;
}
QPushButton#safetyStopButton:hover { background-color: #a52a35; border-color: white; }
QPushButton#safetyStopButton:checked { background-color: #dc2626; border: 2px solid white; }
QPushButton#safetyStopButton:checked:hover { background-color: #ef4444; }
